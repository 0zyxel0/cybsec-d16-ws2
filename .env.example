# PORT for the express server
PORT=3000

# =========================================================================
# NocoDB Configuration
# =========================================================================
# For NocoDB v1 (legacy):
# NOCODB_API_URL=https://<your-nocodb-host>/api/v1/db/data/v1/<project-name>/<table-name>
#
# For NocoDB v2 / v3 (current):
# In NocoDB v2/v3, you should use the Tables REST API. Go to your NocoDB dashboard,
# click on "three dots" next to your table -> "Copy Table ID".
# The URL should look like this:
# NOCODB_API_URL=https://<your-nocodb-host>/api/v2/tables/<table-id>/records
# =========================================================================
NOCODB_API_URL=https://<your-nocodb-host>/api/v2/tables/<your-table-id>/records
NOCODB_TOKEN=your-nocodb-api-token-here
